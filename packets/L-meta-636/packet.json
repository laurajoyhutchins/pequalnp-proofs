  "source_updated_at": "2026-11-24T15:47:09.666Z",
  "statement": "∀ (n : ℕ) (C : PEqualNP.CircuitLowerBounds.Circuit) (H : (Fin n → Bool) → Bool) (e : Fin (n + 1)) (pn pm pS : Fin C.gates.length), PEqualNP.MetaComplexity.FanInTwo C → e ≠ Fin.last n → (∃ y y' : Fin n → Bool, H y ≠ H y') → (∀ x : Fin (n + 1) → Bool, PEqualNP.MetaComplexity.circuitFun (n + 1) C (Function.update x e true) = (x (Fin.last n) || H (fun i : Fin n => x i.castSucc))) → PEqualNP.MetaComplexity.circuitFun (n + 1) C (fun i : Fin (n + 1) => decide (i = Fin.last n)) = false → (C.gates.get pn).op = PEqualNP.CircuitLowerBounds.GateOp.not → (C.gates.get pn).inputs.head? = some e.val → (C.gates.get pm).op = PEqualNP.CircuitLowerBounds.GateOp.and → n + 1 + pn.val ∈ (C.gates.get pm).inputs → (C.gates.get pS).op = PEqualNP.CircuitLowerBounds.GateOp.or → n + 1 + pm.val ∈ (C.gates.get pS).inputs → (∀ j : Fin C.gates.length, ((C.gates.get j).op = PEqualNP.CircuitLowerBounds.GateOp.not ∧ (C.gates.get j).inputs.head? = some (e.val) ∨ (C.gates.get j).op ≠ PEqualNP.CircuitLowerBounds.GateOp.not ∧ (e.val) ∈ (C.gates.get j).inputs) → j = pn) → (∀ j : Fin C.gates.length, ((C.gates.get j).op = PEqualNP.CircuitLowerBounds.GateOp.not ∧ (C.gates.get j).inputs.head? = some (n + 1 + pn.val) ∨ (C.gates.get j).op ≠ PEqualNP.CircuitLowerBounds.GateOp.not ∧ (n + 1 + pn.val) ∈ (C.gates.get j).inputs) → j = pm) → (∀ j : Fin C.gates.length, ((C.gates.get j).op = PEqualNP.CircuitLowerBounds.GateOp.not ∧ (C.gates.get j).inputs.head? = some (n + 1 + pm.val) ∨ (C.gates.get j).op ≠ PEqualNP.CircuitLowerBounds.GateOp.not ∧ (n + 1 + pm.val) ∈ (C.gates.get j).inputs) → j = pS) → PEqualNP.MetaComplexity.HasCircuitSize (n + 1) (fun x : Fin (n + 1) → Bool => PEqualNP.MetaComplexity.circuitFun (n + 1) C (Function.update x e true)) (C.gates.length - 4) ∧ (∀ ph : Fin C.gates.length, ph ≠ pn → n + 1 + ph.val ∈ (C.gates.get pm).inputs → (∀ j : Fin C.gates.length, ((C.gates.get j).op = PEqualNP.CircuitLowerBounds.GateOp.not ∧ (C.gates.get j).inputs.head? = some (n + 1 + ph.val) ∨ (C.gates.get j).op ≠ PEqualNP.CircuitLowerBounds.GateOp.not ∧ (n + 1 + ph.val) ∈ (C.gates.get j).inputs) → j = pm) → PEqualNP.MetaComplexity.HasCircuitSize (n + 1) (fun x : Fin (n + 1) → Bool => PEqualNP.MetaComplexity.circuitFun (n + 1) C (Function.update x e true)) (C.gates.length - 5))",
